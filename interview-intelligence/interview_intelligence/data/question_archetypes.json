{
  "version": "arch-1",
  "archetypes": [
    {"id": "intro_walkthrough", "name": "Background walkthrough", "question_type": "intro", "competency_tags": ["communication", "motivation_role_fit"],
     "pattern": "Ask for a short walkthrough of the candidate's background that leads to this role.",
     "intent": "Warm-up; observe structure and the career narrative.", "expected_evidence": ["coherent narrative", "links to the role", "appropriate length"],
     "strong_signals": ["2-minute, chronological, ends with why this role"], "weak_signals": ["reads the CV line by line", "no link to the role"], "red_flags": [],
     "probe_tree": ["Why did you move from X to Y?", "What is the thread connecting these choices?"], "must_not_infer": [], "difficulty_range": [1, 2], "modes": ["*"], "expected_duration_s": 150},
    {"id": "cv_claim_verification", "name": "CV claim verification ladder", "question_type": "cv_deep_dive", "competency_tags": ["ownership", "leadership", "functional_knowledge"],
     "pattern": "Pick one specific CV claim and ask the candidate to take you through it; then climb surface -> depth -> ownership -> evidence -> outcome.",
     "intent": "Test whether a CV claim holds up and what the candidate personally did.", "expected_evidence": ["context and objective", "personal actions and decisions", "how the result was measured", "baseline and attribution"],
     "strong_signals": ["clear personal decisions", "measurable result with baseline", "honest about team contribution"], "weak_signals": ["'we' throughout", "cannot give the baseline", "activity without outcome"], "red_flags": ["numbers change between answers", "cannot describe own role"],
     "probe_tree": ["What exactly did you own?", "How was the team structured, and what was your part?", "Which decisions were yours?", "What was the baseline and how did you measure the result?", "How much of the result is attributable to your work?", "What would you do differently?"],
     "must_not_infer": ["dishonesty from a single inconsistency"], "difficulty_range": [2, 5], "modes": ["*"], "expected_duration_s": 300},
    {"id": "ownership_deep_dive", "name": "Ownership deep dive", "question_type": "behavioral", "competency_tags": ["ownership", "learning_reflection"],
     "pattern": "Ask for a time they took responsibility for an outcome beyond their brief.",
     "intent": "Personal accountability and follow-through.", "expected_evidence": ["what was at stake", "personal actions", "obstacles handled", "result"],
     "strong_signals": ["self-initiated", "specific actions", "measurable outcome"], "weak_signals": ["assigned task framed as ownership"], "red_flags": [],
     "probe_tree": ["What made it yours rather than someone else's?", "What was the hardest moment?", "What happened as a result?"], "must_not_infer": [], "difficulty_range": [2, 4], "modes": ["*"], "expected_duration_s": 240},
    {"id": "quantified_impact_probe", "name": "Quantified impact", "question_type": "behavioral", "competency_tags": ["ownership", "commercial_judgment", "analytical_reasoning"],
     "pattern": "Ask about the most measurable impact they have had and how they know it was their impact.",
     "intent": "Quantification, baseline, attribution.", "expected_evidence": ["metric", "baseline", "time frame", "attribution logic"],
     "strong_signals": ["baseline + delta + attribution reasoning"], "weak_signals": ["percentages without base", "no attribution"], "red_flags": ["implausible metrics"],
     "probe_tree": ["What was the baseline?", "Over what period?", "What else changed at the same time?", "How much was yours?"], "must_not_infer": [], "difficulty_range": [2, 5], "modes": ["*"], "expected_duration_s": 240},
    {"id": "conflict_behavioral", "name": "Conflict", "question_type": "behavioral", "competency_tags": ["conflict_management", "stakeholder_management", "collaboration"],
     "pattern": "Ask for a real disagreement with a colleague, manager or client and how it was resolved.",
     "intent": "Handling disagreement constructively.", "expected_evidence": ["the other side's view", "own actions", "resolution", "relationship after"],
     "strong_signals": ["states the other view fairly", "concrete steps"], "weak_signals": ["no real conflict", "other person simply wrong"], "red_flags": [],
     "probe_tree": ["What was their reasoning?", "What did you do first?", "Where did you end up and how is the relationship now?"], "must_not_infer": [], "difficulty_range": [2, 4], "modes": ["*"], "expected_duration_s": 240},
    {"id": "failure_reflection", "name": "Failure and learning", "question_type": "behavioral", "competency_tags": ["learning_reflection", "ownership"],
     "pattern": "Ask about a real failure or mistake, what their part was and what changed after.",
     "intent": "Self-awareness and learning.", "expected_evidence": ["genuine failure", "own part", "specific lesson", "later application"],
     "strong_signals": ["owns their part", "applies the lesson later"], "weak_signals": ["humble-brag", "generic lesson"], "red_flags": ["blames entirely on others"],
     "probe_tree": ["What was your part in it?", "What would you do differently?", "Where have you applied that since?"], "must_not_infer": [], "difficulty_range": [2, 4], "modes": ["*"], "expected_duration_s": 240},
    {"id": "leadership_influence", "name": "Leading or influencing", "question_type": "behavioral", "competency_tags": ["leadership", "stakeholder_management"],
     "pattern": "Ask about a time they led people or influenced a decision without formal authority.",
     "intent": "Leadership actions, not titles.", "expected_evidence": ["goal", "how they mobilised people", "resistance handled", "outcome"],
     "strong_signals": ["specific influencing actions", "handled resistance"], "weak_signals": ["title-based leadership"], "red_flags": ["team-size claims inconsistent"],
     "probe_tree": ["Who disagreed and why?", "What did you do to bring them along?", "What would have happened without you?"], "must_not_infer": [], "difficulty_range": [2, 5], "modes": ["*"], "expected_duration_s": 270},
    {"id": "stakeholder_conflict_situational", "name": "Stakeholder situation", "question_type": "situational", "competency_tags": ["situational_judgment", "stakeholder_management", "prioritization"],
     "pattern": "Present a realistic role-specific situation with conflicting stakeholder demands and limited time.",
     "intent": "Judgment under competing demands.", "expected_evidence": ["clarifies goals", "prioritisation criteria", "communication plan", "risk awareness"],
     "strong_signals": ["clarifies before acting", "explicit trade-off"], "weak_signals": ["tries to please everyone"], "red_flags": ["unethical shortcut"],
     "probe_tree": ["What would you do in the first hour?", "Who do you disappoint, and how?", "What if your manager disagrees?"], "must_not_infer": [], "difficulty_range": [2, 5], "modes": ["*"], "expected_duration_s": 240},
    {"id": "prioritization_tradeoff", "name": "Prioritisation trade-off", "question_type": "situational", "competency_tags": ["prioritization", "commercial_judgment"],
     "pattern": "Give 3-4 competing role-specific priorities with a constraint; ask what they do and what they drop.",
     "intent": "Explicit criteria and trade-offs.", "expected_evidence": ["criteria", "choice", "what is dropped", "mitigation"],
     "strong_signals": ["names what is dropped", "criteria tied to business impact"], "weak_signals": ["does everything"], "red_flags": [],
     "probe_tree": ["You can only do one. Which?", "What's the cost of not doing the others?", "How would you communicate that?"], "must_not_infer": [], "difficulty_range": [2, 5], "modes": ["*"], "expected_duration_s": 210},
    {"id": "concept_explain_apply", "name": "Concept explain & apply", "question_type": "functional", "competency_tags": ["functional_knowledge"],
     "pattern": "Ask the candidate to explain a role-critical concept and then apply it to a concrete situation from the role.",
     "intent": "Depth: understanding beyond definitions.", "expected_evidence": ["correct explanation", "application to the scenario", "nuance or limitation"],
     "strong_signals": ["applies correctly", "names a limitation"], "weak_signals": ["definition only"], "red_flags": ["fundamental error"],
     "probe_tree": ["How would that change if <condition>?", "Where does this break down?", "Give me a real example."], "must_not_infer": [], "difficulty_range": [2, 5], "modes": ["*"], "expected_duration_s": 210},
    {"id": "applied_functional_scenario", "name": "Applied functional scenario", "question_type": "functional", "competency_tags": ["functional_knowledge", "problem_solving"],
     "pattern": "Present a realistic problem from the role's day-to-day and ask how they'd analyse and act.",
     "intent": "Functional judgment in context.", "expected_evidence": ["right questions/data", "sound analysis", "action and metric"],
     "strong_signals": ["asks for the right data", "action tied to a metric"], "weak_signals": ["generic plan"], "red_flags": [],
     "probe_tree": ["What data would you look at first?", "What would change your mind?", "How would you measure success?"], "must_not_infer": [], "difficulty_range": [2, 5], "modes": ["*"], "expected_duration_s": 270},
    {"id": "metric_definition", "name": "Metric definition & diagnosis", "question_type": "functional", "competency_tags": ["analytical_reasoning", "product_metrics", "marketing_analytics"],
     "pattern": "Ask how they would define success for a role-relevant initiative, then present a metric drop to diagnose.",
     "intent": "Metric thinking and structured diagnosis.", "expected_evidence": ["primary + guardrail metric", "segmented diagnosis", "hypotheses ranked"],
     "strong_signals": ["internal vs external split", "segments data"], "weak_signals": ["vanity metric", "random guesses"], "red_flags": [],
     "probe_tree": ["The metric dropped 15% last week. Where do you start?", "Which segment would you check first and why?"], "must_not_infer": [], "difficulty_range": [2, 5], "modes": ["*"], "expected_duration_s": 270},
    {"id": "mini_case", "name": "Role-specific mini case", "question_type": "case", "competency_tags": ["case_structuring", "problem_solving", "commercial_judgment", "quantitative_reasoning"],
     "pattern": "Give a compact business problem relevant to the role with 1-2 numbers; ask for structure, analysis and a recommendation.",
     "intent": "Structured problem solving and business judgment.", "expected_evidence": ["clarifies objective", "tailored structure", "uses the numbers", "recommendation with risks"],
     "strong_signals": ["hypothesis-led", "correct math", "answer-first recommendation"], "weak_signals": ["memorised framework", "no recommendation"], "red_flags": ["math errors changing the answer"],
     "probe_tree": ["What's your hypothesis?", "Walk me through the numbers.", "So what do you recommend?", "What's the biggest risk?"], "must_not_infer": [], "difficulty_range": [2, 5], "modes": ["case", "mixed", "final_round", "company_simulation", "hiring_manager"], "expected_duration_s": 420},
    {"id": "estimation", "name": "Estimation", "question_type": "estimation", "competency_tags": ["market_sizing_estimation", "quantitative_reasoning", "structured_thinking"],
     "pattern": "Ask for a role-relevant estimate (market size, volume, capacity).",
     "intent": "Transparent assumptions and logic.", "expected_evidence": ["approach", "assumptions", "calculation", "sanity check"],
     "strong_signals": ["segmentation", "sanity check"], "weak_signals": ["unexplained numbers"], "red_flags": [],
     "probe_tree": ["Why that approach?", "Which assumption matters most?", "How would you sanity-check this?"], "must_not_infer": [], "difficulty_range": [2, 4], "modes": ["case", "mixed"], "expected_duration_s": 300},
    {"id": "debugging_walkthrough", "name": "Debugging walkthrough", "question_type": "technical", "competency_tags": ["debugging_troubleshooting", "technical_depth"],
     "pattern": "Describe a realistic failure in the candidate's stack and ask how they'd diagnose it.",
     "intent": "Systematic troubleshooting.", "expected_evidence": ["reproduce", "isolate with data", "root cause", "prevention"],
     "strong_signals": ["hypothesis-driven narrowing", "uses observability"], "weak_signals": ["random changes"], "red_flags": [],
     "probe_tree": ["What do you check first?", "The logs show nothing. Now what?", "How do you stop it recurring?"], "must_not_infer": [], "difficulty_range": [2, 5], "modes": ["technical", "technical_deep_dive", "mixed"], "expected_duration_s": 300},
    {"id": "system_design_lite", "name": "System design (verbal)", "question_type": "technical", "competency_tags": ["system_design"],
     "pattern": "Ask for a high-level design of a role-relevant system, then deep-dive one component and its trade-offs.",
     "intent": "Architecture reasoning and trade-offs.", "expected_evidence": ["requirements and scale", "components and data flow", "trade-offs", "failure handling"],
     "strong_signals": ["drives requirements", "justifies trade-offs"], "weak_signals": ["boxes without reasoning"], "red_flags": [],
     "probe_tree": ["What are the scale assumptions?", "Where is the bottleneck?", "What happens when X fails?"], "must_not_infer": [], "difficulty_range": [3, 5], "modes": ["technical", "technical_deep_dive", "final_round"], "expected_duration_s": 480},
    {"id": "technical_concept_depth", "name": "Technical concept depth ladder", "question_type": "technical", "competency_tags": ["technical_depth", "cs_fundamentals"],
     "pattern": "Ask about a technical concept the role relies on and descend: concept -> how it works -> implementation -> trade-offs -> limitations.",
     "intent": "Depth beyond keywords.", "expected_evidence": ["correct concept", "mechanism", "trade-offs", "limits"],
     "strong_signals": ["goes two levels deep correctly"], "weak_signals": ["stops at definition"], "red_flags": ["confidently wrong"],
     "probe_tree": ["How does it work under the hood?", "When would you not use it?", "What breaks at scale?"], "must_not_infer": [], "difficulty_range": [2, 5], "modes": ["*"], "expected_duration_s": 240},
    {"id": "project_deep_dive_technical", "name": "Technical project deep dive", "question_type": "cv_deep_dive", "competency_tags": ["technical_depth", "ownership", "system_design"],
     "pattern": "Pick a technical project from the CV and probe architecture, their decisions and trade-offs.",
     "intent": "Real technical ownership.", "expected_evidence": ["architecture", "their decisions", "trade-offs", "what they'd change"],
     "strong_signals": ["explains why, not just what"], "weak_signals": ["cannot explain components they claim"], "red_flags": ["claims collapse under detail"],
     "probe_tree": ["Draw me the architecture in words.", "Which decision was yours?", "What would you change now?"], "must_not_infer": [], "difficulty_range": [2, 5], "modes": ["*"], "expected_duration_s": 360},
    {"id": "motivation_role_fit", "name": "Motivation & role fit", "question_type": "motivation", "competency_tags": ["motivation_role_fit", "role_company_understanding"],
     "pattern": "Ask why this role/company now and what they understand the role to involve.",
     "intent": "Specific, credible motivation.", "expected_evidence": ["specific reasons", "understanding of the role", "coherent narrative"],
     "strong_signals": ["specific to the company and role"], "weak_signals": ["generic reasons"], "red_flags": [],
     "probe_tree": ["What do you think the first 90 days look like?", "What would make you leave this role?"], "must_not_infer": [], "difficulty_range": [1, 3], "modes": ["*"], "expected_duration_s": 180},
    {"id": "company_role_simulation", "name": "Company & role simulation", "question_type": "company", "competency_tags": ["role_company_understanding", "commercial_judgment"],
     "pattern": "Use JD-stated company context to pose a problem this role would face at this company.",
     "intent": "Applying understanding of the company to the role.", "expected_evidence": ["understands the business model", "relevant priorities", "practical plan"],
     "strong_signals": ["grounded in the stated context"], "weak_signals": ["generic"], "red_flags": [],
     "probe_tree": ["What would you prioritise first here?", "What do you think is the biggest risk for this business?"], "must_not_infer": [], "difficulty_range": [2, 5], "modes": ["company_simulation", "hiring_manager", "final_round", "mixed"], "expected_duration_s": 300},
    {"id": "hiring_manager_judgment", "name": "Hiring-manager judgment", "question_type": "situational", "competency_tags": ["prioritization", "commercial_judgment", "ownership"],
     "pattern": "Ask what they'd do in their first weeks given a concrete messy situation in the team.",
     "intent": "Business judgment, ownership, prioritisation.", "expected_evidence": ["diagnosis first", "priorities", "quick wins vs long-term", "stakeholders"],
     "strong_signals": ["diagnoses before prescribing", "concrete first steps"], "weak_signals": ["boil the ocean"], "red_flags": [],
     "probe_tree": ["What would you not touch in the first month?", "How would you know it's working?"], "must_not_infer": [], "difficulty_range": [3, 5], "modes": ["hiring_manager", "final_round", "company_simulation"], "expected_duration_s": 270},
    {"id": "pressure_pushback", "name": "Pressure pushback", "question_type": "pressure", "competency_tags": ["handling_challenge"],
     "pattern": "Challenge the candidate's previous answer professionally: ask for evidence, add a constraint, or force a choice.",
     "intent": "Defending reasoning with evidence; updating when wrong.", "expected_evidence": ["evidence offered", "reasoned position", "constructive update if warranted"],
     "strong_signals": ["stays on substance", "evidence-based response"], "weak_signals": ["capitulates instantly", "repeats without support"], "red_flags": [],
     "probe_tree": ["I'm not convinced. What evidence do you have?", "You have two weeks, not two months. What changes?", "You can only do one. Which?"], "must_not_infer": ["confidence as a personality trait", "stress tolerance"], "difficulty_range": [3, 5], "modes": ["stress", "grill"], "expected_duration_s": 150},
    {"id": "contradiction_clarify", "name": "Contradiction clarification", "question_type": "cv_deep_dive", "competency_tags": ["ownership"],
     "pattern": "Neutrally point to two statements that do not match and ask the candidate to clarify.",
     "intent": "Resolve an inconsistency without assuming bad faith.", "expected_evidence": ["clear reconciliation"],
     "strong_signals": ["clear, consistent explanation"], "weak_signals": ["evasive"], "red_flags": ["further inconsistency"],
     "probe_tree": ["Help me reconcile those two."], "must_not_infer": ["dishonesty"], "difficulty_range": [1, 5], "modes": ["*"], "expected_duration_s": 90},
    {"id": "closing_questions", "name": "Closing", "question_type": "closing", "competency_tags": ["motivation_role_fit"],
     "pattern": "Invite the candidate's questions and close the interview.",
     "intent": "Close professionally.", "expected_evidence": [], "strong_signals": [], "weak_signals": [], "red_flags": [],
     "probe_tree": [], "must_not_infer": [], "difficulty_range": [1, 1], "modes": ["*"], "expected_duration_s": 120}
  ]
}
