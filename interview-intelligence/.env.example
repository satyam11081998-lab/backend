# Interview Intelligence — environment reference.
#
# HOW II RUNS NOW (host mode): inside the existing consilio-backend process, mounted at /ii
# (routes/interview_intelligence.py). No separate service. Only TWO values are required on
# the backend's Render service:
#     II_DATABASE_URL     Supabase Session-pooler URL for the ii_service role (see below)
#     II_ENCRYPTION_KEY   python -m scripts.generate_keys  (keep a copy in a password manager)
# AI keys are shared: if II_OPENAI_API_KEY is empty II uses the backend's OPENAI_API_KEY (same for
# GROQ_API_KEY, GEMINI_API_KEY / GOOGLE_API_KEY, ANTHROPIC_API_KEY, GOOGLE_DRIVE_*).
# Identity comes from the backend's own Supabase session check, so the assertion keys below
# are NOT used in host mode and nothing is needed on Vercel.
#
# Real values live in Render. Never commit them, never paste them into .brain/ or handoffs.

# ---- runtime ---------------------------------------------------------------------------
# prod | dev | test | qa. Anything other than dev/test/qa is treated as production
# (no simulated AI, encryption key required, Postgres required, /docs hidden).
II_ENV=dev
II_LOG_LEVEL=INFO
# host mode defaults: 1 worker thread and a 3-connection pool (the backend box is shared)
II_WORKER_THREADS=1
II_DB_POOL_SIZE=3

# ---- database (own schema, own role; see migrations/0001_interview_intel.sql) ----------
# Render cannot reach Supabase's IPv6-only direct host; use the SESSION pooler (port 5432):
# postgresql://ii_service.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# (not the transaction pooler on 6543). Unset = II stays dormant and /ii answers 503.
II_DATABASE_URL=
II_DB_SCHEMA=interview_intel

# ---- entitlement assertion (STANDALONE mode only; ignored in host mode) ------------------
II_ASSERTION_PUBLIC_KEY=
II_ASSERTION_KID=k1
# Rotation: JSON {"k1": "<pem>", "k2": "<pem>"} instead of the single key above.
II_ASSERTION_PUBLIC_KEYS=
II_ASSERTION_MAX_LIFETIME_S=900

# ---- admins and test access ------------------------------------------------------------
# II admins by email (comma-separated). MECE admins (users.is_admin, the signed `adm` claim)
# are also II admins unless II_TRUST_MECE_ADMIN=false.
II_ADMIN_EMAILS=
II_TRUST_MECE_ADMIN=true
# Two test accounts are inserted into access_grants on first start (never re-enabled if an
# admin later disables them). Placeholders only — fill in the real addresses in Render:
#   II_BOOTSTRAP_TEST_EMAILS=<test-account-1-email>,<test-account-2-email>
# After the first deploy, manage test users from Admin → Interview Intelligence instead.
II_BOOTSTRAP_TEST_EMAILS=

# ---- security ---------------------------------------------------------------------------
II_ENCRYPTION_KEY=
# CORS: standalone only — in host mode the backend's own CORS settings apply.
II_CORS_ORIGINS=http://localhost:3000,https://mece.in,https://www.mece.in
II_CORS_ORIGIN_REGEX=https://[a-z0-9-]+-consilioo\.vercel\.app

# ---- limits (defaults; admins can override at runtime in Admin → Settings) --------------
II_MAX_ACTIVE_SESSIONS=2
II_MAX_SESSIONS_PER_DAY=5
II_MAX_UPLOAD_MB=5
II_SESSION_COST_CAP_USD=1.50
II_DAILY_BUDGET_USD=25

# ---- AI providers: optional II-only keys; empty = use the backend's own keys ------------
II_OPENAI_API_KEY=
II_OPENAI_BASE_URL=https://api.openai.com/v1
II_ANTHROPIC_API_KEY=
II_GROQ_API_KEY=
II_GEMINI_API_KEY=
II_PROVIDER_FAST=openai
II_MODEL_FAST=gpt-4o-mini
II_PROVIDER_STRONG=openai
II_MODEL_STRONG=gpt-4o
# Optional per-route / per-prompt chains, e.g.
# II_MODEL_ROUTES={"strong":[{"provider":"anthropic","model":"claude-sonnet-4-5"},{"provider":"openai","model":"gpt-4o"}]}
II_MODEL_ROUTES=
II_AI_TIMEOUT_S=45
# Optional price overrides (USD per 1M tokens): {"model": [input, output]}
II_PRICE_TABLE=
# Offline simulated models outside dev/test (qa only; ignored in production)
II_ALLOW_SIMULATION=

# ---- Google Drive (optional; documents stay encrypted in the DB until Drive confirms) ---
# Off unless II_GDRIVE_ROOT_FOLDER_ID is set (client id/secret/refresh token fall back to
# the backend's GOOGLE_DRIVE_* values).
II_GDRIVE_ROOT_FOLDER_ID=
II_GDRIVE_CLIENT_ID=
II_GDRIVE_CLIENT_SECRET=
II_GDRIVE_REFRESH_TOKEN=
# or a service account (base64 of the JSON key) writing into a Shared Drive:
II_GDRIVE_SA_JSON=
II_DRIVE_FOLDER_SALT=
II_PURGE_BLOB_AFTER_DRIVE_SYNC=false

# =========================================================================================
# STANDALONE mode only (not used now): the MECE frontend would sign assertions with
#   NEXT_PUBLIC_II_API_URL, II_ASSERTION_PRIVATE_KEY, II_ASSERTION_KID   (Vercel)
# In host mode the frontend calls <NEXT_PUBLIC_API_URL>/ii with the Supabase session token.
